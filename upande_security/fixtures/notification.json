%2722.8%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2724.4%27%20cy%3D%2727.2%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2719.6%27%20cy%3D%2727.2%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2718.2%27%20cy%3D%2722.8%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2722%27%20cy%3D%2724%27%20r%3D%271.5%27%20fill%3D%27%23F6C84C%27%20opacity%3D%270.5%27%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%27%23C0396B%27%20opacity%3D%270.16%27%3E%3Ccircle%20cx%3D%2770%27%20cy%3D%2762%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2773.8%27%20cy%3D%2764.8%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2772.4%27%20cy%3D%2769.2%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2767.6%27%20cy%3D%2769.2%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2766.2%27%20cy%3D%2764.8%27%20r%3D%272.3%27%2F%3E%3Ccircle%20cx%3D%2770%27%20cy%3D%2766%27%20r%3D%271.5%27%20fill%3D%27%23F6C84C%27%20opacity%3D%270.5%27%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%27%23C0396B%27%20opacity%3D%270.10%27%3E%3Ccircle%20cx%3D%2774%27%20cy%3D%2720%27%20r%3D%272%27%2F%3E%3Ccircle%20cx%3D%2720%27%20cy%3D%2770%27%20r%3D%272%27%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E\") repeat;padding:24px 0;\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"640\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:640px;width:100%;background:#FFFFFF;border-radius:14px;overflow:hidden;box-shadow:0 6px 20px rgba(122,31,61,0.15);\">\n      {%- set host = frappe.db.get_value('Employee', doc.custom_meet_with, 'employee_name') if doc.custom_meet_with else None -%}\n\n      <!-- HEADER -->\n      <tr><td style=\"background:linear-gradient(135deg,#7A1F3D 0%,#C0396B 100%);padding:34px 30px;text-align:center;\">\n        <div style=\"display:inline-block;background:#FCE7EF;color:#7A1F3D;font-size:11px;letter-spacing:2px;font-weight:bold;padding:6px 16px;border-radius:20px;text-transform:uppercase;margin-bottom:14px;\">🌸 Visitor at Reception</div>\n        <h1 style=\"color:#FFFFFF;margin:0;font-size:26px;font-weight:700;letter-spacing:0.3px;\">You Have a Visitor</h1>\n        <p style=\"color:#FCE7EF;margin:10px 0 0 0;font-size:14px;\">Karen Roses Limited — Grown with Care</p>\n      </td></tr>\n\n      <!-- VISITOR BANNER -->\n      <tr><td style=\"background:#FCE7EF;padding:24px 30px;border-bottom:4px solid #E8799F;\">\n        <div style=\"font-size:11px;color:#9B5C6E;letter-spacing:2px;text-transform:uppercase;font-weight:bold;margin-bottom:8px;\">Now at Reception</div>\n        <h2 style=\"color:#7A1F3D;margin:0 0 6px 0;font-size:24px;font-weight:700;line-height:1.3;\">{{ doc.customer_name or 'Visitor' }}</h2>\n        <p style=\"color:#C0396B;margin:0;font-size:14px;font-weight:500;\">\n          {% if doc.custom_visitor_type %}<span style=\"background:#E8799F;color:#FFFFFF;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;\">{{ doc.custom_visitor_type }}</span>&nbsp;{% endif %}\n          {% if doc.customer_phone_number %}<span style=\"color:#9B5C6E;font-weight:600;\">📞 {{ doc.customer_phone_number }}</span>{% endif %}\n        </p>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\"padding:30px;color:#7A1F3D;font-size:15px;line-height:1.6;\">\n        <p style=\"margin:0 0 20px 0;color:#3D3D3D;\">Hello{% if host %} <strong style=\"color:#7A1F3D;\">{{ host }}</strong>{% endif %}, a visitor has just arrived to see you. Please review and approve their entry.</p>\n\n        <!-- DETAILS TABLE -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #FCE7EF;border-radius:10px;overflow:hidden;margin:0 0 24px 0;\">\n          <tr style=\"background:#7A1F3D;\"><td colspan=\"2\" style=\"padding:12px 16px;color:#FCE7EF;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;font-weight:bold;\">🌷 Visitor Details</td></tr>\n          <tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;width:42%;border-bottom:1px solid #F3D9E3;\">Visitor</td><td style=\"padding:11px 16px;color:#7A1F3D;font-weight:600;border-bottom:1px solid #F3D9E3;\">{{ doc.customer_name or '—' }}</td></tr>\n          {% if doc.customer_phone_number %}<tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Phone</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">{{ doc.customer_phone_number }}</td></tr>{% endif %}\n          {% if host %}<tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Meeting With</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">{{ host }}</td></tr>{% endif %}\n          {% if doc.custom_meet_with_company %}<tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Company</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">{{ doc.custom_meet_with_company }}</td></tr>{% endif %}\n          {% if doc.custom_meet_with_farm %}<tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Farm / Unit</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">📍 {{ doc.custom_meet_with_farm }}</td></tr>{% endif %}\n          {% if doc.custom_mode_of_transport %}<tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Transport</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">{{ doc.custom_mode_of_transport }}{% if doc.custom_vehicles_number_plate %} &middot; <strong>{{ doc.custom_vehicles_number_plate }}</strong>{% endif %}{% if doc.custom_vehicles_colour %} ({{ doc.custom_vehicles_colour }}){% endif %}{% if doc.custom_number_of_passengers %} &middot; {{ doc.custom_number_of_passengers }} pax{% endif %}</td></tr>{% endif %}\n          <tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;border-bottom:1px solid #F3D9E3;\">Arrived</td><td style=\"padding:11px 16px;color:#7A1F3D;border-bottom:1px solid #F3D9E3;\">{{ frappe.utils.format_datetime(doc.custom_check_in_time or doc.scheduled_time or doc.creation) }}</td></tr>\n          <tr><td style=\"padding:11px 16px;background:#FDF5F8;font-weight:600;color:#C0396B;\">Status</td><td style=\"padding:11px 16px;\"><span style=\"background:#E8799F;color:#FFFFFF;padding:4px 12px;border-radius:14px;font-size:12px;font-weight:700;\">{{ doc.workflow_state or doc.status }}</span></td></tr>\n        </table>\n\n        {% if doc.customer_details %}\n        <div style=\"background:#FDF5F8;border-left:4px solid #E8799F;padding:18px 20px;border-radius:0 10px 10px 0;margin:0 0 24px 0;\">\n          <div style=\"font-size:11px;color:#9B5C6E;letter-spacing:1.5px;text-transform:uppercase;font-weight:bold;margin-bottom:10px;\">🌸 Purpose of Visit</div>\n          <div style=\"color:#7A1F3D;font-size:14px;line-height:1.7;\">{{ doc.customer_details }}</div>\n        </div>\n        {% endif %}\n\n        <!-- CTA -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0 8px 0;\">\n          <tr><td align=\"center\" style=\"padding-bottom:12px;\"><div style=\"font-size:13px;color:#9B5C6E;letter-spacing:1px;text-transform:uppercase;font-weight:bold;\">Approve their entry</div></td></tr>\n          <tr><td align=\"center\">\n            <a href=\"{{ frappe.utils.get_url() }}/app/appointment/{{ doc.name }}\" style=\"display:inline-block;background:linear-gradient(135deg,#7A1F3D 0%,#C0396B 100%);color:#FFFFFF;padding:16px 48px;text-decoration:none;border-radius:50px;font-weight:bold;font-size:16px;letter-spacing:0.8px;box-shadow:0 6px 16px rgba(122,31,61,0.4);text-transform:uppercase;\">🌸 Review Visitor</a>\n          </td></tr>\n        </table>\n\n        <p style=\"margin:28px 0 0 0;font-size:12px;color:#9B5C6E;text-align:center;font-style:italic;border-top:1px solid #FCE7EF;padding-top:18px;\">Reference: {{ doc.name }}</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\"background:linear-gradient(135deg,#7A1F3D 0%,#5A1530 100%);padding:28px;text-align:center;\">\n        <div style=\"color:#FCE7EF;font-size:20px;font-weight:bold;letter-spacing:3px;margin-bottom:6px;\">KAREN ROSES LIMITED</div>\n        <p style=\"color:#E8799F;margin:0 0 16px 0;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;\">🌹 Premium Roses • Kenya</p>\n        <div style=\"height:1px;background:#C0396B;margin:16px auto;width:60%;\"></div>\n        <p style=\"color:#E8799F;margin:0;font-size:11px;line-height:1.7;\">Automated visitor alert from Karen Roses ERP.<br>Sent {{ frappe.utils.now() }}</p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</div>\n",
