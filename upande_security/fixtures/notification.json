  "message": "<!-- KAITET LTD. — Visitor at Reception — Avocado Palette -->\n<div style=\"margin:0;padding:0;background:#F5F5EE;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#F5F5EE;padding:24px 0;\">\n  <tr><td align=\"center\">\n    <table role=\"presentation\" width=\"640\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:640px;width:100%;background:#FFFFFF;border-radius:14px;overflow:hidden;box-shadow:0 6px 20px rgba(45,74,30,0.15);\">\n      {%- set host = frappe.db.get_value('Employee', doc.custom_meet_with, 'employee_name') if doc.custom_meet_with else None -%}\n\n      <!-- HEADER -->\n      <tr><td style=\"background:linear-gradient(135deg,#2D4A1E 0%,#4A7C2E 100%);padding:34px 30px;text-align:center;\">\n        <div style=\"display:inline-block;background:#E8E4C9;color:#2D4A1E;font-size:11px;letter-spacing:2px;font-weight:bold;padding:6px 16px;border-radius:20px;text-transform:uppercase;margin-bottom:14px;\">🌿 Visitor at Reception</div>\n        <h1 style=\"color:#FFFFFF;margin:0;font-size:26px;font-weight:700;letter-spacing:0.3px;\">You Have a Visitor</h1>\n        <p style=\"color:#E8E4C9;margin:10px 0 0 0;font-size:14px;\">Kaitet Ltd. — Growing Together</p>\n      </td></tr>\n\n      <!-- VISITOR BANNER -->\n      <tr><td style=\"background:#E8E4C9;padding:24px 30px;border-bottom:4px solid #9DBF6E;\">\n        <div style=\"font-size:11px;color:#6B4423;letter-spacing:2px;text-transform:uppercase;font-weight:bold;margin-bottom:8px;\">Now at Reception</div>\n        <h2 style=\"color:#2D4A1E;margin:0 0 6px 0;font-size:24px;font-weight:700;line-height:1.3;\">{{ doc.customer_name or 'Visitor' }}</h2>\n        <p style=\"color:#4A7C2E;margin:0;font-size:14px;font-weight:500;\">\n          {% if doc.custom_visitor_type %}<span style=\"background:#9DBF6E;color:#FFFFFF;padding:3px 10px;border-radius:12px;font-size:11px;font-weight:700;\">{{ doc.custom_visitor_type }}</span>&nbsp;{% endif %}\n          {% if doc.customer_phone_number %}<span style=\"color:#6B4423;font-weight:600;\">📞 {{ doc.customer_phone_number }}</span>{% endif %}\n        </p>\n      </td></tr>\n\n      <!-- BODY -->\n      <tr><td style=\"padding:30px;color:#2D4A1E;font-size:15px;line-height:1.6;\">\n        <p style=\"margin:0 0 20px 0;color:#3D3D3D;\">Hello{% if host %} <strong style=\"color:#2D4A1E;\">{{ host }}</strong>{% endif %}, a visitor has just arrived to see you. Please review and approve their entry.</p>\n\n        <!-- DETAILS TABLE -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #E8E4C9;border-radius:10px;overflow:hidden;margin:0 0 24px 0;\">\n          <tr style=\"background:#2D4A1E;\"><td colspan=\"2\" style=\"padding:12px 16px;color:#E8E4C9;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;font-weight:bold;\">🌱 Visitor Details</td></tr>\n          <tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;width:42%;border-bottom:1px solid #F0EFE5;\">Visitor</td><td style=\"padding:11px 16px;color:#2D4A1E;font-weight:600;border-bottom:1px solid #F0EFE5;\">{{ doc.customer_name or '—' }}</td></tr>\n          {% if doc.customer_phone_number %}<tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Phone</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">{{ doc.customer_phone_number }}</td></tr>{% endif %}\n          {% if host %}<tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Meeting With</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">{{ host }}</td></tr>{% endif %}\n          {% if doc.custom_meet_with_company %}<tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Company</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">{{ doc.custom_meet_with_company }}</td></tr>{% endif %}\n          {% if doc.custom_meet_with_farm %}<tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Farm / Unit</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">📍 {{ doc.custom_meet_with_farm }}</td></tr>{% endif %}\n          {% if doc.custom_mode_of_transport %}<tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Transport</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">{{ doc.custom_mode_of_transport }}{% if doc.custom_vehicles_number_plate %} &middot; <strong>{{ doc.custom_vehicles_number_plate }}</strong>{% endif %}{% if doc.custom_vehicles_colour %} ({{ doc.custom_vehicles_colour }}){% endif %}{% if doc.custom_number_of_passengers %} &middot; {{ doc.custom_number_of_passengers }} pax{% endif %}</td></tr>{% endif %}\n          <tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;border-bottom:1px solid #F0EFE5;\">Arrived</td><td style=\"padding:11px 16px;color:#2D4A1E;border-bottom:1px solid #F0EFE5;\">{{ frappe.utils.format_datetime(doc.custom_check_in_time or doc.scheduled_time or doc.creation) }}</td></tr>\n          <tr><td style=\"padding:11px 16px;background:#FAFBF6;font-weight:600;color:#4A7C2E;\">Status</td><td style=\"padding:11px 16px;\"><span style=\"background:#9DBF6E;color:#FFFFFF;padding:4px 12px;border-radius:14px;font-size:12px;font-weight:700;\">{{ doc.workflow_state or doc.status }}</span></td></tr>\n        </table>\n\n        {% if doc.customer_details %}\n        <div style=\"background:#FAFBF6;border-left:4px solid #9DBF6E;padding:18px 20px;border-radius:0 10px 10px 0;margin:0 0 24px 0;\">\n          <div style=\"font-size:11px;color:#6B4423;letter-spacing:1.5px;text-transform:uppercase;font-weight:bold;margin-bottom:10px;\">🌿 Purpose of Visit</div>\n          <div style=\"color:#2D4A1E;font-size:14px;line-height:1.7;\">{{ doc.customer_details }}</div>\n        </div>\n        {% endif %}\n\n        <!-- CTA -->\n        <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:28px 0 8px 0;\">\n          <tr><td align=\"center\" style=\"padding-bottom:12px;\"><div style=\"font-size:13px;color:#6B4423;letter-spacing:1px;text-transform:uppercase;font-weight:bold;\">Approve their entry</div></td></tr>\n          <tr><td align=\"center\">\n            <a href=\"{{ frappe.utils.get_url() }}/app/appointment/{{ doc.name }}\" style=\"display:inline-block;background:linear-gradient(135deg,#2D4A1E 0%,#4A7C2E 100%);color:#FFFFFF;padding:16px 48px;text-decoration:none;border-radius:50px;font-weight:bold;font-size:16px;letter-spacing:0.8px;box-shadow:0 6px 16px rgba(45,74,30,0.4);text-transform:uppercase;\">🌿 Review Visitor</a>\n          </td></tr>\n        </table>\n\n        <p style=\"margin:28px 0 0 0;font-size:12px;color:#6B4423;text-align:center;font-style:italic;border-top:1px solid #E8E4C9;padding-top:18px;\">Reference: {{ doc.name }}</p>\n      </td></tr>\n\n      <!-- FOOTER -->\n      <tr><td style=\"background:linear-gradient(135deg,#2D4A1E 0%,#1F3514 100%);padding:28px;text-align:center;\">\n        <div style=\"color:#E8E4C9;font-size:20px;font-weight:bold;letter-spacing:3px;margin-bottom:6px;\">KAITET LTD.</div>\n        <p style=\"color:#9DBF6E;margin:0 0 16px 0;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;\">🥑 Premium Avocados • Kenya</p>\n        <div style=\"height:1px;background:#4A7C2E;margin:16px auto;width:60%;\"></div>\n        <p style=\"color:#9DBF6E;margin:0;font-size:11px;line-height:1.7;\">Automated visitor alert from Kaitet ERP.<br>Sent {{ frappe.utils.now() }}</p>\n      </td></tr>\n\n    </table>\n  </td></tr>\n</table>\n</div>\n",
