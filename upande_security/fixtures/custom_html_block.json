  "html": "<div class=\"secn\">\n\n  <div class=\"secn-title\">Security Operations</div>\n\n  <div class=\"secn-grid\">\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"Web Page\"\n      data-ref-name=\"security-dasboard\"\n      href=\"/security-dashboard\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(37,99,235,.13);color:#2563eb\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/>\n          <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/>\n          <rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>\n          <rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Dashboards</span>\n        <span class=\"secn-sub\">Overview &amp; KPIs</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Appointment\"\n      href=\"/app/appointment?custom_visitor_type=Visitor\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(34,197,94,.13);color:#16a34a\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/>\n          <circle cx=\"9\" cy=\"7\" r=\"4\"/>\n          <polyline points=\"16 11 18 13 22 9\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Visitors</span>\n        <span class=\"secn-sub\">Visitor registration and access</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Visitor Badge\"\n      href=\"/app/visitor-badge\"\n    >\n      <span\n        cla