gba(99,102,241,.13);color:#4f46e5\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/>\n          <polyline points=\"14 2 14 8 20 8\"/>\n          <line x1=\"8\" y1=\"13\" x2=\"16\" y2=\"13\"/>\n          <line x1=\"8\" y1=\"17\" x2=\"13\" y2=\"17\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Patrol Reports</span>\n        <span class=\"secn-sub\">Guard observations for review</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Near Miss Report\"\n      href=\"/app/near-miss-report\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(249,115,22,.13);color:#ea580c\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n          <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/>\n          <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Near Misses</span>\n        <span class=\"secn-sub\">Quick-file observations before they escalate</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Security Watchlist\"\n      href=\"/app/security-watchlist\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(185,28,28,.13);color:#b91c1c\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n          <line x1=\"4.93\" y1=\"4.93\" x2=\"19.07\" y2=\"19.07\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Watchlist</span>\n        <span class=\"secn-sub\">Blocked persons checked at the gate</span>\n      </span>\n    </a>\n\n  </div>\n\n  <div class=\"secn-title secn-title-admin\">\n    Security Administration\n  </div>\n\n  <div class=\"secn-grid\">\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Security Guard\"\n      href=\"/app/security-guard\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(37,99,235,.13);color:#2563eb\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n          <path d=\"M9 12l2 2 4-4\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Security Guards</span>\n        <span class=\"secn-sub\">Guard profiles and deployment</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Security Guard Shift Assignment\"\n      href=\"/app/security-guard-shift-assignment\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(168,85,247,.13);color:#9333ea\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n          <polyline points=\"12 7 12 12 16 14\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Shift Assignments</span>\n        <span class=\"secn-sub\">Guard shifts and duty allocation</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Incident Category\"\n      href=\"/app/incident-category\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(244,63,94,.13);color:#e11d48\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <path d=\"M3 7h18\"/>\n          <path d=\"M3 12h18\"/>\n          <path d=\"M3 17h10\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Incident Categories</span>\n        <span class=\"secn-sub\">Incident types and classification</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Guard Device Token\"\n      href=\"/app/guard-device-token\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(14,116,144,.13);color:#0e7490\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <rect x=\"7\" y=\"2\" width=\"10\" height=\"20\" rx=\"2\"/>\n          <line x1=\"11\" y1=\"18\" x2=\"13\" y2=\"18\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Guard Devices</span>\n        <span class=\"secn-sub\">Registered phones for SOS push alerts</span>\n      </span>\n    </a>\n\n    <a\n      class=\"secn-tile\"\n      data-roles=\"\"\n      data-ref-type=\"DocType\"\n      data-ref-name=\"Security Ops Settings\"\n      href=\"/app/security-ops-settings\"\n    >\n      <span\n        class=\"secn-ic\"\n        style=\"background:rgba(71,85,105,.13);color:#475569\"\n      >\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"2\">\n          <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n          <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z\"/>\n        </svg>\n      </span>\n\n      <span class=\"secn-tx\">\n        <span class=\"secn-lb\">Ops Settings</span>\n        <span class=\"secn-sub\">SOS routing and nearby-guard-alert config</span>\n      </span>\n    </a>\n\n    </div>\n\n</div>",
