.security-command-centre {
	padding: 18px;
	min-height: calc(100vh - 130px);
	background: #f6f8fb;
}

.sd-intro {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 20px;
	margin-bottom: 18px;
}

.sd-intro h2 {
	margin: 0;
	color: #162033;
	font-size: 25px;
	font-weight: 700;
}

.sd-intro p {
	margin: 5px 0 0;
	color: #697386;
}

.sd-live-status {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 8px 12px;
	border: 1px solid #e5e9f0;
	border-radius: 8px;
	background: #fff;
	color: #667085;
	font-size: 11px;
}

.sd-live-dot {
	display: inline-block;
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: #22a447;
	box-shadow: 0 0 0 4px rgba(34, 164, 71, 0.12);
}

.sd-kpi-grid {
	display: grid;
	grid-template-columns: repeat(6, minmax(145px, 1fr));
	gap: 13px;
	margin-bottom: 16px;
}

.sd-kpi-card {
	display: flex;
	align-items: flex-start;
	gap: 11px;
	min-height: 108px;
	padding: 15px;
	border: 1px solid #e4e9f0;
	border-radius: 12px;
	background: #fff;
	text-align: left;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
	transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.sd-kpi-card:hover {
	transform: translateY(-2px);
	box-shadow: 0 7px 18px rgba(16, 24, 40, 0.09);
}

.sd-kpi-icon {
	display: grid;
	place-items: center;
	width: 39px;
	height: 39px;
	flex: 0 0 39px;
	border-radius: 10px;
	font-size: 18px;
	font-weight: 700;
}

.sd-icon-blue {
	background: #e8f1ff;
	color: #2166dc;
}

.sd-icon-green {
	background: #e8f8ed;
	color: #16833b;
}

.sd-icon-purple {
	background: #f1eafe;
	color: #7138c7;
}

.sd-icon-red {
	background: #feeaea;
	color: #cc2c2c;
}

.sd-kpi-body {
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.sd-kpi-label {
	color: #344054;
	font-size: 12px;
	font-weight: 600;
}

.sd-kpi-body strong {
	margin: 7px 0 4px;
	color: #101828;
	font-size: 26px;
	line-height: 1;
}

.sd-kpi-body small {
	color: #778195;
	font-size: 10px;
}

.sd-main-grid {
	display: grid;
	grid-template-columns:
		minmax(420px, 1.75fr)
		minmax(280px, 1fr)
		minmax(280px, 1fr);
	gap: 16px;
	margin-bottom: 16px;
}

.sd-bottom-grid {
	display: grid;
	grid-template-columns:
		minmax(250px, 0.85fr)
		minmax(520px, 1.8fr)
		minmax(270px, 0.9fr);
	gap: 16px;
}

.sd-panel {
	overflow: hidden;
	border: 1px solid #e4e9f0;
	border-radius: 12px;
	background: #fff;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.sd-panel-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 14px;
	padding: 14px 15px;
	border-bottom: 1px solid #edf0f4;
}

.sd-panel-header h3 {
	margin: 0;
	color: #1d2939;
	font-size: 14px;
	font-weight: 700;
}

.sd-panel-header p {
	margin: 3px 0 0;
	color: #8490a2;
	font-size: 10px;
}

.sd-map {
	position: relative;
	overflow: hidden;
	min-height: 320px;
	background:
		radial-gradient(circle at 15% 30%, #dcebd7 0 7%, transparent 8%),
		radial-gradient(circle at 70% 70%, #dcebd7 0 8%, transparent 9%),
		linear-gradient(135deg, #edf4e9, #e8f1f5);
}

.sd-map::before {
	content: "";
	position: absolute;
	inset: 0;
	opacity: 0.3;
	background-image:
		linear-gradient(#aebdca 1px, transparent 1px),
		linear-gradient(90deg, #aebdca 1px, transparent 1px);
	background-size: 42px 42px;
}

.sd-map-road {
	position: absolute;
	z-index: 1;
	border: 2px dashed #4688e8;
	border-radius: 50%;
}

.sd-road-one {
	inset: 48px 50px 62px 45px;
	transform: rotate(5deg);
}

.sd-road-two {
	width: 250px;
	height: 145px;
	left: 130px;
	top: 92px;
	transform: rotate(-14deg);
}

.sd-map-marker {
	position: absolute;
	z-index: 2;
	display: flex;
	flex-direction: column;
	padding: 7px 10px;
	border: 1px solid #3181ec;
	border-radius: 7px;
	background: #fff;
	color: #2166ce;
	font-size: 10px;
	box-shadow: 0 4px 12px rgba(16, 24, 40, 0.13);
}

.sd-map-marker span {
	margin-top: 2px;
	font-size: 8px;
}

.sd-gate-a {
	left: 4%;
	top: 27%;
}

.sd-gate-b {
	left: 48%;
	top: 9%;
}

.sd-checkpoint-one {
	right: 18%;
	top: 20%;
	border-color: #25a35a;
	color: #197a3d;
}

.sd-checkpoint-two {
	left: 41%;
	bottom: 24%;
	border-color: #25a35a;
	color: #197a3d;
}

.sd-restricted-zone {
	position: absolute;
	z-index: 2;
	right: 7%;
	top: 43%;
	display: grid;
	place-items: center;
	width: 170px;
	height: 92px;
	border: 2px dashed #e74a4a;
	border-radius: 8px;
	background: rgba(254, 226, 226, 0.86);
	color: #b52525;
	text-align: center;
	transform: rotate(-5deg);
}

.sd-restricted-zone span {
	display: block;
	margin-top: 3px;
	font-size: 9px;
}

.sd-map-footer {
	position: absolute;
	z-index: 3;
	left: 14px;
	bottom: 12px;
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 6px 9px;
	border-radius: 6px;
	background: rgba(255, 255, 255, 0.92);
	color: #657084;
	font-size: 10px;
}

.sd-alert-list {
	padding: 10px;
}

.sd-alert {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 10px;
	margin-bottom: 8px;
	padding: 11px;
	border-left: 4px solid;
	border-radius: 8px;
}

.sd-alert:last-child {
	margin-bottom: 0;
}

.sd-alert-high {
	border-color: #db3535;
	background: #fff2f2;
}

.sd-alert-medium {
	border-color: #ed9a1e;
	background: #fff8e9;
}

.sd-alert-low {
	border-color: #2f7de1;
	background: #eef5ff;
}

.sd-alert strong,
.sd-alert span {
	display: block;
}

.sd-alert strong {
	color: #2b3445;
	font-size: 11px;
}

.sd-alert > div > span {
	margin-top: 3px;
	color: #737d8e;
	font-size: 9px;
}

.sd-alert-meta {
	text-align: right;
	color: #727d8e;
	font-size: 9px;
}

.sd-alert-meta span {
	margin-top: 5px;
	padding: 3px 7px;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.7);
}

.sd-patrol-chart {
	display: flex;
	align-items: flex-end;
	justify-content: space-around;
	gap: 8px;
	height: 195px;
	padding: 22px 15px 5px;
	border-bottom: 1px solid #edf0f4;
	background:
		repeating-linear-gradient(
			to top,
			transparent 0,
			transparent 38px,
			#edf0f4 39px
		);
}

.sd-bar-column {
	display: flex;
	flex: 1;
	flex-direction: column;
	align-items: center;
	justify-content: flex-end;
	height: 100%;
}

.sd-bar-stack {
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	width: 22px;
	height: 145px;
}

.sd-bar-completed {
	background: #31a852;
}

.sd-bar-late {
	background: #ef9d21;
}

.sd-bar-missed {
	background: #e45656;
}

.sd-bar-column > span {
	margin-top: 5px;
	color: #778195;
	font-size: 8px;
}

.sd-chart-legend {
	display: flex;
	justify-content: center;
	gap: 15px;
	padding: 9px;
	color: #687386;
	font-size: 9px;
}

.sd-chart-legend i,
.sd-occupancy-list i {
	display: inline-block;
	width: 8px;
	height: 8px;
	margin-right: 5px;
	border-radius: 50%;
}

.sd-legend-completed {
	background: #31a852;
}

.sd-legend-late {
	background: #ef9d21;
}

.sd-legend-missed {
	background: #e45656;
}

.sd-patrol-summary {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	align-items: center;
	padding: 10px 14px 14px;
}

.sd-patrol-summary > div {
	display: flex;
	flex-direction: column;
	text-align: center;
}

.sd-patrol-summary strong {
	color: #1f2937;
	font-size: 17px;
}

.sd-patrol-summary span {
	color: #7c8799;
	font-size: 8px;
}

.sd-compliance-ring {
	display: grid !important;
	place-items: center;
	width: 52px;
	height: 52px;
	margin: auto;
	border: 6px solid #3eaf5e;
	border-radius: 50%;
	color: #197a3d;
	font-weight: 700;
}

.sd-occupancy {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 28px;
	min-height: 270px;
	padding: 20px;
}

.sd-donut {
	display: grid;
	place-items: center;
	width: 145px;
	height: 145px;
	border-radius: 50%;
	background: conic-gradient(
		#2563eb 0 54%,
		#25a653 54% 73%,
		#7a44ce 73% 87%,
		#f2a11e 87% 100%
	);
}

.sd-donut::before {
	content: "";
	position: absolute;
	width: 91px;
	height: 91px;
	border-radius: 50%;
	background: #fff;
}

.sd-donut > div {
	position: relative;
	z-index: 2;
	text-align: center;
}

.sd-donut strong,
.sd-donut span {
	display: block;
}

.sd-donut strong {
	color: #1e293b;
	font-size: 25px;
}

.sd-donut span {
	color: #778195;
	font-size: 8px;
}

.sd-occupancy-list {
	min-width: 120px;
}

.sd-occupancy-list > div {
	display: grid;
	grid-template-columns: 15px 1fr auto;
	align-items: center;
	gap: 4px;
	margin-bottom: 11px;
	color: #667085;
	font-size: 10px;
}

.sd-dot-blue {
	background: #2563eb;
}

.sd-dot-green {
	background: #25a653;
}

.sd-dot-purple {
	background: #7a44ce;
}

.sd-dot-orange {
	background: #f2a11e;
}

.sd-table-wrapper {
	overflow-x: auto;
}

.sd-actions-table {
	margin: 0;
}

.sd-actions-table th {
	color: #788398;
	font-size: 9px;
	font-weight: 600;
	text-transform: uppercase;
}

.sd-actions-table td {
	color: #394456;
	font-size: 10px;
	vertical-align: middle;
}

.sd-badge,
.sd-status {
	display: inline-flex;
	padding: 3px 7px;
	border-radius: 999px;
	white-space: nowrap;
}

.sd-badge-high {
	background: #fee2e2;
	color: #b91c1c;
}

.sd-badge-medium {
	background: #fef3c7;
	color: #92400e;
}

.sd-badge-low {
	background: #dbeafe;
	color: #1d4ed8;
}

.sd-status {
	background: #f0f2f5;
	color: #566174;
}

.sd-activity-list {
	padding: 9px 12px;
}

.sd-activity {
	display: grid;
	grid-template-columns: 40px 10px 1fr;
	gap: 8px;
	padding: 10px 0;
	border-bottom: 1px solid #edf0f4;
}

.sd-activity:last-child {
	border-bottom: 0;
}

.sd-activity time {
	color: #7d8798;
	font-size: 9px;
}

.sd-activity i {
	width: 8px;
	height: 8px;
	margin-top: 3px;
	border-radius: 50%;
	background: #2da750;
}

.sd-activity strong,
.sd-activity span {
	display: block;
}

.sd-activity strong {
	color: #344054;
	font-size: 10px;
}

.sd-activity span {
	margin-top: 2px;
	color: #818b9b;
	font-size: 9px;
}

@media (max-width: 1400px) {
	.sd-kpi-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.sd-main-grid {
		grid-template-columns: 1fr 1fr;
	}

	.sd-map-panel {
		grid-column: 1 / -1;
	}

	.sd-bottom-grid {
		grid-template-columns: 1fr 1fr;
	}

	.sd-actions-panel {
		grid-column: 1 / -1;
	}
}

@media (max-width: 800px) {
	.sd-intro {
		flex-direction: column;
	}

	.sd-kpi-grid,
	.sd-main-grid,
	.sd-bottom-grid {
		grid-template-columns: 1fr;
	}

	.sd-map-panel,
	.sd-actions-panel {
		grid-column: auto;
	}
}
