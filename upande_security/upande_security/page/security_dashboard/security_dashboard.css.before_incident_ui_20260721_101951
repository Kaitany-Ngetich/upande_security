.security-command-centre {
	padding: 18px;
	min-height: calc(100vh - 130px);
	background: #f6f8fb;
}

.sd-intro {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 20px;
	margin-bottom: 18px;
}

.sd-intro h2 {
	margin: 0;
	color: #162033;
	font-size: 25px;
	font-weight: 700;
}

.sd-intro p {
	margin: 5px 0 0;
	color: #697386;
}

.sd-live-status {
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 8px 12px;
	border: 1px solid #e5e9f0;
	border-radius: 8px;
	background: #fff;
	color: #667085;
	font-size: 11px;
}

.sd-live-dot {
	display: inline-block;
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: #22a447;
	box-shadow: 0 0 0 4px rgba(34, 164, 71, 0.12);
}

.sd-kpi-grid {
	display: grid;
	grid-template-columns: repeat(6, minmax(145px, 1fr));
	gap: 13px;
	margin-bottom: 16px;
}

.sd-kpi-card {
	display: flex;
	align-items: flex-start;
	gap: 11px;
	min-height: 108px;
	padding: 15px;
	border: 1px solid #e4e9f0;
	border-radius: 12px;
	background: #fff;
	text-align: left;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
	transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.sd-kpi-card:hover {
	transform: translateY(-2px);
	box-shadow: 0 7px 18px rgba(16, 24, 40, 0.09);
}

.sd-kpi-icon {
	display: grid;
	place-items: center;
	width: 39px;
	height: 39px;
	flex: 0 0 39px;
	border-radius: 10px;
	font-size: 18px;
	font-weight: 700;
}

.sd-icon-blue {
	background: #e8f1ff;
	color: #2166dc;
}

.sd-icon-green {
	background: #e8f8ed;
	color: #16833b;
}

.sd-icon-purple {
	background: #f1eafe;
	color: #7138c7;
}

.sd-icon-red {
	background: #feeaea;
	color: #cc2c2c;
}

.sd-kpi-body {
	display: flex;
	flex-direction: column;
	min-width: 0;
}

.sd-kpi-label {
	color: #344054;
	font-size: 12px;
	font-weight: 600;
}

.sd-kpi-body strong {
	margin: 7px 0 4px;
	color: #101828;
	font-size: 26px;
	line-height: 1;
}

.sd-kpi-body small {
	color: #778195;
	font-size: 10px;
}

.sd-main-grid {
	display: grid;
	grid-template-columns:
		minmax(420px, 1.75fr)
		minmax(280px, 1fr)
		minmax(280px, 1fr);
	gap: 16px;
	margin-bottom: 16px;
}

.sd-bottom-grid {
	display: grid;
	grid-template-columns:
		minmax(250px, 0.85fr)
		minmax(520px, 1.8fr)
		minmax(270px, 0.9fr);
	gap: 16px;
}

.sd-panel {
	overflow: hidden;
	border: 1px solid #e4e9f0;
	border-radius: 12px;
	background: #fff;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.sd-panel-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 14px;
	padding: 14px 15px;
	border-bottom: 1px solid #edf0f4;
}

.sd-panel-header h3 {
	margin: 0;
	color: #1d2939;
	font-size: 14px;
	font-weight: 700;
}

.sd-panel-header p {
	margin: 3px 0 0;
	color: #8490a2;
	font-size: 10px;
}

.sd-map {
	position: relative;
	overflow: hidden;
	min-height: 320px;
	background:
		radial-gradient(circle at 15% 30%, #dcebd7 0 7%, transparent 8%),
		radial-gradient(circle at 70% 70%, #dcebd7 0 8%, transparent 9%),
		linear-gradient(135deg, #edf4e9, #e8f1f5);
}

.sd-map::before {
	content: "";
	position: absolute;
	inset: 0;
	opacity: 0.3;
	background-image:
		linear-gradient(#aebdca 1px, transparent 1px),
		linear-gradient(90deg, #aebdca 1px, transparent 1px);
	background-size: 42px 42px;
}

.sd-map-road {
	position: absolute;
	z-index: 1;
	border: 2px dashed #4688e8;
	border-radius: 50%;
}

.sd-road-one {
	inset: 48px 50px 62px 45px;
	transform: rotate(5deg);
}

.sd-road-two {
	width: 250px;
	height: 145px;
	left: 130px;
	top: 92px;
	transform: rotate(-14deg);
}

.sd-map-marker {
	position: absolute;
	z-index: 2;
	display: flex;
	flex-direction: column;
	padding: 7px 10px;
	border: 1px solid #3181ec;
	border-radius: 7px;
	background: #fff;
	color: #2166ce;
	font-size: 10px;
	box-shadow: 0 4px 12px rgba(16, 24, 40, 0.13);
}

.sd-map-marker span {
	margin-top: 2px;
	font-size: 8px;
}

.sd-gate-a {
	left: 4%;
	top: 27%;
}

.sd-gate-b {
	left: 48%;
	top: 9%;
}

.sd-checkpoint-one {
	right: 18%;
	top: 20%;
	border-color: #25a35a;
	color: #197a3d;
}

.sd-checkpoint-two {
	left: 41%;
	bottom: 24%;
	border-color: #25a35a;
	color: #197a3d;
}

.sd-restricted-zone {
	position: absolute;
	z-index: 2;
	right: 7%;
	top: 43%;
	display: grid;
	place-items: center;
	width: 170px;
	height: 92px;
	border: 2px dashed #e74a4a;
	border-radius: 8px;
	background: rgba(254, 226, 226, 0.86);
	color: #b52525;
	text-align: center;
	transform: rotate(-5deg);
}

.sd-restricted-zone span {
	display: block;
	margin-top: 3px;
	font-size: 9px;
}

.sd-map-footer {
	position: absolute;
	z-index: 3;
	left: 14px;
	bottom: 12px;
	display: flex;
	align-items: center;
	gap: 8px;
	padding: 6px 9px;
	border-radius: 6px;
	background: rgba(255, 255, 255, 0.92);
	color: #657084;
	font-size: 10px;
}

.sd-alert-list {
	padding: 10px;
}

.sd-alert {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 10px;
	margin-bottom: 8px;
	padding: 11px;
	border-left: 4px solid;
	border-radius: 8px;
}

.sd-alert:last-child {
	margin-bottom: 0;
}

.sd-alert-high {
	border-color: #db3535;
	background: #fff2f2;
}

.sd-alert-medium {
	border-color: #ed9a1e;
	background: #fff8e9;
}

.sd-alert-low {
	border-color: #2f7de1;
	background: #eef5ff;
}

.sd-alert strong,
.sd-alert span {
	display: block;
}

.sd-alert strong {
	color: #2b3445;
	font-size: 11px;
}

.sd-alert > div > span {
	margin-top: 3px;
	color: #737d8e;
	font-size: 9px;
}

.sd-alert-meta {
	text-align: right;
	color: #727d8e;
	font-size: 9px;
}

.sd-alert-meta span {
	margin-top: 5px;
	padding: 3px 7px;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.7);
}

.sd-patrol-chart {
	display: flex;
	align-items: flex-end;
	justify-content: space-around;
	gap: 8px;
	height: 195px;
	padding: 22px 15px 5px;
	border-bottom: 1px solid #edf0f4;
	background:
		repeating-linear-gradient(
			to top,
			transparent 0,
			transparent 38px,
			#edf0f4 39px
		);
}

.sd-bar-column {
	display: flex;
	flex: 1;
	flex-direction: column;
	align-items: center;
	justify-content: flex-end;
	height: 100%;
}

.sd-bar-stack {
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	width: 22px;
	height: 145px;
}

.sd-bar-completed {
	background: #31a852;
}

.sd-bar-late {
	background: #ef9d21;
}

.sd-bar-missed {
	background: #e45656;
}

.sd-bar-column > span {
	margin-top: 5px;
	color: #778195;
	font-size: 8px;
}

.sd-chart-legend {
	display: flex;
	justify-content: center;
	gap: 15px;
	padding: 9px;
	color: #687386;
	font-size: 9px;
}

.sd-chart-legend i,
.sd-occupancy-list i {
	display: inline-block;
	width: 8px;
	height: 8px;
	margin-right: 5px;
	border-radius: 50%;
}

.sd-legend-completed {
	background: #31a852;
}

.sd-legend-late {
	background: #ef9d21;
}

.sd-legend-missed {
	background: #e45656;
}

.sd-patrol-summary {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	align-items: center;
	padding: 10px 14px 14px;
}

.sd-patrol-summary > div {
	display: flex;
	flex-direction: column;
	text-align: center;
}

.sd-patrol-summary strong {
	color: #1f2937;
	font-size: 17px;
}

.sd-patrol-summary span {
	color: #7c8799;
	font-size: 8px;
}

.sd-compliance-ring {
	display: grid !important;
	place-items: center;
	width: 52px;
	height: 52px;
	margin: auto;
	border: 6px solid #3eaf5e;
	border-radius: 50%;
	color: #197a3d;
	font-weight: 700;
}

.sd-occupancy {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 28px;
	min-height: 270px;
	padding: 20px;
}

.sd-donut {
	display: grid;
	place-items: center;
	width: 145px;
	height: 145px;
	border-radius: 50%;
	background: conic-gradient(
		#2563eb 0 54%,
		#25a653 54% 73%,
		#7a44ce 73% 87%,
		#f2a11e 87% 100%
	);
}

.sd-donut::before {
	content: "";
	position: absolute;
	width: 91px;
	height: 91px;
	border-radius: 50%;
	background: #fff;
}

.sd-donut > div {
	position: relative;
	z-index: 2;
	text-align: center;
}

.sd-donut strong,
.sd-donut span {
	display: block;
}

.sd-donut strong {
	color: #1e293b;
	font-size: 25px;
}

.sd-donut span {
	color: #778195;
	font-size: 8px;
}

.sd-occupancy-list {
	min-width: 120px;
}

.sd-occupancy-list > div {
	display: grid;
	grid-template-columns: 15px 1fr auto;
	align-items: center;
	gap: 4px;
	margin-bottom: 11px;
	color: #667085;
	font-size: 10px;
}

.sd-dot-blue {
	background: #2563eb;
}

.sd-dot-green {
	background: #25a653;
}

.sd-dot-purple {
	background: #7a44ce;
}

.sd-dot-orange {
	background: #f2a11e;
}

.sd-table-wrapper {
	overflow-x: auto;
}

.sd-actions-table {
	margin: 0;
}

.sd-actions-table th {
	color: #788398;
	font-size: 9px;
	font-weight: 600;
	text-transform: uppercase;
}

.sd-actions-table td {
	color: #394456;
	font-size: 10px;
	vertical-align: middle;
}

.sd-badge,
.sd-status {
	display: inline-flex;
	padding: 3px 7px;
	border-radius: 999px;
	white-space: nowrap;
}

.sd-badge-high {
	background: #fee2e2;
	color: #b91c1c;
}

.sd-badge-medium {
	background: #fef3c7;
	color: #92400e;
}

.sd-badge-low {
	background: #dbeafe;
	color: #1d4ed8;
}

.sd-status {
	background: #f0f2f5;
	color: #566174;
}

.sd-activity-list {
	padding: 9px 12px;
}

.sd-activity {
	display: grid;
	grid-template-columns: 40px 10px 1fr;
	gap: 8px;
	padding: 10px 0;
	border-bottom: 1px solid #edf0f4;
}

.sd-activity:last-child {
	border-bottom: 0;
}

.sd-activity time {
	color: #7d8798;
	font-size: 9px;
}

.sd-activity i {
	width: 8px;
	height: 8px;
	margin-top: 3px;
	border-radius: 50%;
	background: #2da750;
}

.sd-activity strong,
.sd-activity span {
	display: block;
}

.sd-activity strong {
	color: #344054;
	font-size: 10px;
}

.sd-activity span {
	margin-top: 2px;
	color: #818b9b;
	font-size: 9px;
}

@media (max-width: 1400px) {
	.sd-kpi-grid {
		grid-template-columns: repeat(3, 1fr);
	}

	.sd-main-grid {
		grid-template-columns: 1fr 1fr;
	}

	.sd-map-panel {
		grid-column: 1 / -1;
	}

	.sd-bottom-grid {
		grid-template-columns: 1fr 1fr;
	}

	.sd-actions-panel {
		grid-column: 1 / -1;
	}
}

@media (max-width: 800px) {
	.sd-intro {
		flex-direction: column;
	}

	.sd-kpi-grid,
	.sd-main-grid,
	.sd-bottom-grid {
		grid-template-columns: 1fr;
	}

	.sd-map-panel,
	.sd-actions-panel {
		grid-column: auto;
	}
}


/* =========================================================
   SECURITY APPLICATION SIDEBAR
   ========================================================= */

.security-app-layout {
	display: grid;
	grid-template-columns: 230px minmax(0, 1fr);
	align-items: stretch;
	min-height: calc(100vh - 105px);
	background: #f6f8fb;
}

.security-app-sidebar {
	position: sticky;
	top: 0;
	align-self: start;
	overflow-y: auto;
	width: 230px;
	height: calc(100vh - 105px);
	border-right: 1px solid #e4e9f0;
	background: #ffffff;
}

.security-app-content {
	min-width: 0;
}

.security-app-content .security-command-centre {
	padding: 18px;
}

.security-sidebar-brand {
	display: flex;
	align-items: center;
	gap: 11px;
	min-height: 75px;
	padding: 16px 17px;
	border-bottom: 1px solid #e8ecf1;
}

.security-sidebar-logo {
	display: grid;
	place-items: center;
	width: 38px;
	height: 38px;
	flex: 0 0 38px;
	border-radius: 10px;
	background: #e8f1ff;
	color: #1766c2;
}

.security-sidebar-brand strong,
.security-sidebar-brand span {
	display: block;
}

.security-sidebar-brand strong {
	color: #172033;
	font-size: 14px;
	font-weight: 700;
}

.security-sidebar-brand span {
	margin-top: 2px;
	color: #7a8495;
	font-size: 10px;
}

.security-sidebar-nav {
	padding: 12px 8px 25px;
}

.security-sidebar-section {
	margin-bottom: 17px;
}

.security-sidebar-heading {
	padding: 4px 10px 7px;
	color: #98a2b3;
	font-size: 9px;
	font-weight: 700;
	letter-spacing: 0.08em;
	text-transform: uppercase;
}

.security-sidebar-link {
	display: flex;
	align-items: center;
	gap: 10px;
	min-height: 38px;
	margin: 2px 0;
	padding: 8px 10px;
	border-radius: 7px;
	color: #526174;
	font-size: 12px;
	font-weight: 500;
	text-decoration: none !important;
	transition:
		background 0.15s ease,
		color 0.15s ease,
		transform 0.15s ease;
}

.security-sidebar-link:hover {
	background: #f0f5fb;
	color: #1766c2;
	transform: translateX(2px);
}

.security-sidebar-link.active {
	background: #e5f0fc;
	color: #125ca9;
	font-weight: 600;
}

.security-sidebar-icon {
	display: grid;
	place-items: center;
	width: 19px;
	height: 19px;
	flex: 0 0 19px;
	color: inherit;
	font-size: 15px;
	line-height: 1;
}

.security-app-sidebar::-webkit-scrollbar {
	width: 5px;
}

.security-app-sidebar::-webkit-scrollbar-track {
	background: transparent;
}

.security-app-sidebar::-webkit-scrollbar-thumb {
	border-radius: 10px;
	background: #d2d8e1;
}

#security-overview,
#recent-security-activity {
	scroll-margin-top: 90px;
}

@media (max-width: 1000px) {
	.security-app-layout {
		grid-template-columns: 72px minmax(0, 1fr);
	}

	.security-app-sidebar {
		width: 72px;
	}

	.security-sidebar-brand {
		justify-content: center;
		padding: 15px 8px;
	}

	.security-sidebar-brand > div:last-child,
	.security-sidebar-heading,
	.security-sidebar-link span:last-child {
		display: none;
	}

	.security-sidebar-link {
		justify-content: center;
		padding: 9px;
	}

	.security-sidebar-icon {
		font-size: 17px;
	}
}

@media (max-width: 650px) {
	.security-app-layout {
		display: block;
	}

	.security-app-sidebar {
		position: relative;
		width: 100%;
		height: auto;
		border-right: 0;
		border-bottom: 1px solid #e4e9f0;
	}

	.security-sidebar-brand {
		justify-content: flex-start;
	}

	.security-sidebar-brand > div:last-child {
		display: block;
	}

	.security-sidebar-nav {
		display: flex;
		overflow-x: auto;
		gap: 7px;
		padding: 8px;
	}

	.security-sidebar-section {
		display: contents;
	}

	.security-sidebar-heading {
		display: none;
	}

	.security-sidebar-link {
		flex: 0 0 auto;
	}

	.security-sidebar-link span:last-child {
		display: block;
	}
}


/* =========================================================
   VISITORS DASHBOARD VIEW
   ========================================================= */

.security-visitors-view {
	min-height: calc(100vh - 105px);
	padding: 24px 18px;
	background: #f6f8fb;
}

.sv-page-heading {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 18px;
	margin-bottom: 18px;
}

.sv-page-heading h2 {
	margin: 0;
	color: #172033;
	font-size: 23px;
	font-weight: 700;
}

.sv-page-heading p {
	margin: 6px 0 0;
	color: #778195;
	font-size: 12px;
}

.sv-heading-actions {
	display: flex;
	gap: 8px;
}

.sv-kpi-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(180px, 1fr));
	gap: 13px;
	margin-bottom: 18px;
}

.sv-kpi-card {
	display: flex;
	align-items: center;
	gap: 14px;
	min-height: 120px;
	padding: 18px;
	border: 1px solid #e2e7ee;
	border-radius: 12px;
	background: #ffffff;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.sv-kpi-card strong,
.sv-kpi-card span {
	display: block;
}

.sv-kpi-card strong {
	color: #111827;
	font-size: 27px;
	line-height: 1;
}

.sv-kpi-card span {
	margin-top: 7px;
	color: #707b8d;
	font-size: 12px;
}

.sv-kpi-icon {
	display: grid;
	place-items: center;
	width: 42px;
	height: 42px;
	flex: 0 0 42px;
	border-radius: 9px;
	font-size: 18px;
	font-weight: 700;
}

.sv-blue {
	background: #e6f1ff;
	color: #1665bb;
}

.sv-green {
	background: #ebf7df;
	color: #42830c;
}

.sv-slate {
	background: #f1eee6;
	color: #54544d;
}

.sv-light-blue {
	background: #e5f1fa;
	color: #39769c;
}

.sv-list-panel {
	overflow: hidden;
	border: 1px solid #e2e7ee;
	border-radius: 11px;
	background: #ffffff;
	box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.sv-filter-bar {
	display: grid;
	grid-template-columns:
		180px
		180px
		minmax(260px, 1fr)
		auto;
	align-items: center;
	gap: 9px;
	padding: 12px;
	border-bottom: 1px solid #e8ecf1;
}

.sv-filter-bar .form-control {
	height: 34px;
	font-size: 12px;
}

.sv-result-count {
	padding-right: 5px;
	color: #778195;
	font-size: 11px;
	white-space: nowrap;
}

.sv-table-wrapper {
	overflow-x: auto;
}

.sv-table {
	min-width: 1050px;
	margin: 0;
}

.sv-table thead th {
	padding: 11px 12px;
	border-top: 0;
	background: #fbfcfd;
	color: #778195;
	font-size: 10px;
	font-weight: 600;
	text-transform: uppercase;
}

.sv-table tbody td {
	padding: 11px 12px;
	color: #344054;
	font-size: 11px;
	vertical-align: middle;
}

.sv-visitor-row {
	cursor: pointer;
}

.sv-visitor-row:hover {
	background: #f7faff;
}

.sv-person {
	display: flex;
	align-items: center;
	gap: 9px;
	min-width: 170px;
}

.sv-person strong {
	color: #273043;
	font-size: 12px;
	font-weight: 600;
}

.sv-avatar {
	display: grid;
	place-items: center;
	width: 30px;
	height: 30px;
	flex: 0 0 30px;
	border-radius: 50%;
	background: #fff0d8;
	color: #9a5b04;
	font-size: 10px;
	font-weight: 700;
}

.sv-transport-badge,
.sv-status-badge {
	display: inline-flex;
	align-items: center;
	gap: 5px;
	padding: 4px 8px;
	border-radius: 999px;
	white-space: nowrap;
}

.sv-transport-badge {
	background: #f5f2eb;
	color: #4d535c;
}

.sv-status-badge {
	background: #f5f2eb;
	color: #59606c;
	font-size: 10px;
}

.sv-loading,
.sv-empty,
.sv-error {
	padding: 45px !important;
	text-align: center;
}

.sv-loading,
.sv-empty {
	color: #8490a2 !important;
}

.sv-error {
	color: #c53030 !important;
}

@media (max-width: 1100px) {
	.sv-kpi-grid {
		grid-template-columns: repeat(2, 1fr);
	}

	.sv-filter-bar {
		grid-template-columns: 1fr 1fr;
	}
}

@media (max-width: 700px) {
	.sv-page-heading {
		flex-direction: column;
	}

	.sv-kpi-grid,
	.sv-filter-bar {
		grid-template-columns: 1fr;
	}
}


/* =========================================================
   PATROLS DASHBOARD VIEW
   ========================================================= */

.security-patrols-view {
        min-height: calc(100vh - 105px);
        padding: 24px 18px;
        background: #f6f8fb;
}

.pv-page-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 14px;
}

.pv-page-heading h2 {
        margin: 0;
        color: #172033;
        font-size: 23px;
        font-weight: 700;
}

.pv-page-heading p {
        margin: 6px 0 0;
        color: #778195;
        font-size: 12px;
}

.pv-heading-actions {
        display: flex;
        gap: 8px;
}

.pv-live-strip {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
        padding: 9px 12px;
        border: 1px solid #dce6f1;
        border-radius: 8px;
        background: #ffffff;
        color: #667085;
        font-size: 11px;
}

.pv-live-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        border-radius: 50%;
        background: #22a447;
        box-shadow: 0 0 0 4px rgba(34, 164, 71, 0.12);
}

.pv-last-updated {
        margin-left: auto;
}

.pv-kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(145px, 1fr));
        gap: 13px;
        margin-bottom: 17px;
}

.pv-kpi-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-height: 105px;
        padding: 16px;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.pv-kpi-card strong,
.pv-kpi-card span {
        display: block;
}

.pv-kpi-card strong {
        color: #111827;
        font-size: 26px;
        line-height: 1;
}

.pv-kpi-card > div > span {
        margin-top: 7px;
        color: #707b8d;
        font-size: 11px;
}

.pv-kpi-icon {
        display: grid !important;
        place-items: center;
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 9px;
        font-size: 17px;
        font-weight: 700;
}

.pv-blue {
        background: #e6f1ff;
        color: #1665bb;
}

.pv-green {
        background: #e6f7eb;
        color: #16833b;
}

.pv-amber {
        background: #fff2d8;
        color: #a16207;
}

.pv-purple {
        background: #f1eafe;
        color: #7138c7;
}

.pv-red {
        background: #feeaea;
        color: #c82c2c;
}

.pv-main-grid {
        display: grid;
        grid-template-columns: minmax(280px, 0.7fr) minmax(650px, 2fr);
        gap: 16px;
}

.pv-panel {
        overflow: hidden;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
}

.pv-panel-header {
        padding: 14px 15px;
        border-bottom: 1px solid #e8ecf1;
}

.pv-panel-header h3 {
        margin: 0;
        color: #273043;
        font-size: 14px;
        font-weight: 700;
}

.pv-panel-header p {
        margin: 4px 0 0;
        color: #8490a2;
        font-size: 10px;
}

.pv-position-list {
        max-height: 575px;
        overflow-y: auto;
        padding: 9px;
}

.pv-position-card {
        width: 100%;
        display: grid;
        grid-template-columns: minmax(100px, 1fr) auto auto;
        align-items: center;
        gap: 10px;
        margin-bottom: 7px;
        padding: 11px;
        border: 1px solid #e8ecf1;
        border-radius: 8px;
        background: #fbfcfd;
        text-align: left;
}

.pv-position-card:hover {
        border-color: #b9d2ef;
        background: #f4f8fd;
}

.pv-position-card strong,
.pv-position-card span {
        display: block;
}

.pv-position-card strong {
        color: #273043;
        font-size: 11px;
}

.pv-position-card > div > span {
        margin-top: 3px;
        color: #7c8799;
        font-size: 9px;
}

.pv-position-coordinates {
        color: #566174;
        font-family: monospace;
        font-size: 9px;
        text-align: right;
}

.pv-filter-bar {
        display: grid;
        grid-template-columns:
                155px
                175px
                minmax(230px, 1fr)
                auto;
        align-items: center;
        gap: 9px;
        padding: 12px;
        border-bottom: 1px solid #e8ecf1;
}

.pv-filter-bar .form-control {
        height: 34px;
        font-size: 11px;
}

.pv-result-count {
        padding-right: 4px;
        color: #778195;
        font-size: 10px;
        white-space: nowrap;
}

.pv-table-wrapper {
        overflow-x: auto;
}

.pv-table {
        min-width: 1200px;
        margin: 0;
}

.pv-table thead th {
        padding: 11px 10px;
        border-top: 0;
        background: #fbfcfd;
        color: #778195;
        font-size: 9px;
        font-weight: 600;
        text-transform: uppercase;
}

.pv-table tbody td {
        padding: 11px 10px;
        color: #344054;
        font-size: 10px;
        vertical-align: middle;
}

.pv-patrol-row {
        cursor: pointer;
}

.pv-patrol-row:hover {
        background: #f7faff;
}

.pv-status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 600;
        white-space: nowrap;
}

.pv-status-active {
        background: #dcfce7;
        color: #166534;
}

.pv-status-stale {
        background: #fef3c7;
        color: #92400e;
}

.pv-status-historical {
        background: #e5e7eb;
        color: #4b5563;
}

.pv-loading,
.pv-empty,
.pv-error {
        padding: 40px !important;
        text-align: center;
}

.pv-loading,
.pv-empty {
        color: #8490a2 !important;
}

.pv-error {
        color: #c53030 !important;
}

@media (max-width: 1350px) {
        .pv-kpi-grid {
                grid-template-columns: repeat(3, 1fr);
        }

        .pv-main-grid {
                grid-template-columns: 1fr;
        }
}

@media (max-width: 750px) {
        .pv-page-heading {
                flex-direction: column;
        }

        .pv-heading-actions {
                flex-wrap: wrap;
        }

        .pv-kpi-grid,
        .pv-filter-bar {
                grid-template-columns: 1fr;
        }

        .pv-last-updated {
                margin-left: 0;
        }
}
